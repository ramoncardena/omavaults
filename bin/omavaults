#!/bin/bash

# omaVaults helper: git + Obsidian plumbing for the omaVaults bar widget.
#
# Every command prints a single JSON object on stdout. Failures print
# {"ok":false,"error":"..."} and exit non-zero, so the QML side can show the
# message without parsing stderr.
#
#   omavaults status <dir>               repo + per-vault sync state
#   omavaults clone  <url> <dir>         clone the vaults repo
#   omavaults fetch  <dir> [--max-age N] refresh remote-tracking refs; skip if the
#                                        last fetch is under N seconds old
#   omavaults sync   <dir> [vault]       commit, pull --rebase, push
#   omavaults create <dir> <name>        new vault folder, committed and pushed
#   omavaults import <dir> <folder> [name]
#                                        copy an existing vault in, commit and push
#   omavaults candidates <dir>           Obsidian vaults outside the repo
#   omavaults pick-folder [start]        native folder chooser; prints the choice
#   omavaults visibility <url>           public / private / unknown (anonymous API check)
#   omavaults config-save <url> <dir> [interval]
#                                        persist settings outside shell.json
#   omavaults register [--restart] <dir> [vault...]
#                                        add repo vaults (all, or the named ones) to Obsidian's list;
#                                        exits 3 with needsRestart if Obsidian runs
#   omavaults open   [--restart] <dir> <vault>
#                                        register the vault and open it in Obsidian;
#                                        exits 3 with needsRestart if Obsidian must restart
#
# A vault is any non-hidden top-level directory of the repo.

set -uo pipefail

# Never block on a credential or host-key prompt: there is no terminal behind
# the bar. Respect a user-provided GIT_SSH_COMMAND.
export GIT_TERMINAL_PROMPT=0
export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -o BatchMode=yes -o ConnectTimeout=10}"

# The bar is often started without SSH_AUTH_SOCK in its environment; fall back
# to the systemd user agent socket so keys loaded there are usable.
if [[ -z ${SSH_AUTH_SOCK:-} && -S ${XDG_RUNTIME_DIR:-/run/user/$UID}/ssh-agent.socket ]]; then
  export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR:-/run/user/$UID}/ssh-agent.socket"
fi

OBSIDIAN_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/obsidian/obsidian.json"
# Disabling a widget drops its shell.json entry, settings included; this copy
# lets a re-enabled widget pick its configuration back up.
OMAVAULTS_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/omavaults/config.json"

fail() {
  jq -cn --arg error "$*" '{ok: false, error: $error}'
  exit 1
}

ok() {
  jq -cn --arg message "${1:-}" '{ok: true, message: $message}'
  exit 0
}

# Sets $dir (not echoed: fail() must exit the main shell, not a subshell).
expand_dir() {
  dir="${1:-}"
  [[ -n $dir ]] || fail "no local path configured"
  [[ $dir == "~" || $dir == "~/"* ]] && dir="$HOME${dir:1}"
  dir="${dir%/}"
}

valid_vault() {
  local name="$1"
  [[ -n $name && $name != .* && $name != */* ]]
}

in_repo() {
  git -C "$1" rev-parse --is-inside-work-tree >/dev/null 2>&1
}

has_upstream() {
  git -C "$1" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1
}

# The first "fatal:"/"error:" line is the useful one; fall back to the last line.
git_error() {
  if [[ $1 == *"Permission denied (publickey)"* ]]; then
    printf '%s' "SSH key not available (passphrase-protected key with no ssh-agent?). Use the HTTPS URL, or run: ssh-add"
    return
  fi
  local line
  line=$(printf '%s\n' "$1" | grep -m1 -E '^(fatal|error): ')
  [[ -n $line ]] || line=$(printf '%s\n' "$1" | grep -v '^\s*$' | tail -n 1)
  printf '%s' "$line" | sed -E 's/^(fatal|error): //' | redact_urls
}

# "https://user:token@host/x" -> "https://***@host/x"
redact_urls() {
  sed -E 's#(://)[^/@[:space:]]+@#\1***@#g'
}

# Serialize everything that mutates refs, so the periodic fetch never races a
# sync started from the panel.
with_lock() {
  local dir="$1"
  shift
  local gitdir
  gitdir=$(git -C "$dir" rev-parse --absolute-git-dir 2>/dev/null) || fail "not a git repository: $dir"
  exec 9>"$gitdir/omavaults.lock"
  flock -w 120 9 || fail "another sync is still running"
  "$@"
}

cmd_status() {
  local dir
  expand_dir "${1:-}"

  if ! in_repo "$dir"; then
    jq -cn --arg dir "$dir" --argjson exists "$([[ -e $dir ]] && echo true || echo false)" \
      '{ok: true, cloned: false, exists: $exists, dir: $dir, vaults: []}'
    return
  fi

  local branch upstream=false ahead=0 behind=0 rebasing=false last_fetch=0 remote_url gitdir
  gitdir=$(git -C "$dir" rev-parse --absolute-git-dir)
  branch=$(git -C "$dir" symbolic-ref --short -q HEAD || echo "")
  remote_url=$(git -C "$dir" remote get-url origin 2>/dev/null || echo "")
  [[ -d $gitdir/rebase-merge || -d $gitdir/rebase-apply || -f $gitdir/MERGE_HEAD ]] && rebasing=true
  [[ -f $gitdir/FETCH_HEAD ]] && last_fetch=$(stat -c %Y "$gitdir/FETCH_HEAD")

  if has_upstream "$dir"; then
    upstream=true
    read -r ahead behind < <(git -C "$dir" rev-list --left-right --count 'HEAD...@{u}' 2>/dev/null || echo "0 0")
  fi

  local vaults_json="[]" name path dirty v_ahead v_behind conflicts state last_commit copies in_obsidian
  while IFS= read -r -d '' path; do
    name=$(basename "$path")
    dirty=$(git -C "$dir" status --porcelain --untracked-files=all -- "$name" 2>/dev/null | wc -l)
    conflicts=$(git -C "$dir" diff --name-only --diff-filter=U -- "$name" 2>/dev/null | wc -l)
    v_ahead=0
    v_behind=0
    if $upstream; then
      v_ahead=$(git -C "$dir" rev-list --count '@{u}..HEAD' -- "$name" 2>/dev/null || echo 0)
      v_behind=$(git -C "$dir" rev-list --count 'HEAD..@{u}' -- "$name" 2>/dev/null || echo 0)
    fi
    last_commit=$(git -C "$dir" log -1 --format=%ct -- "$name" 2>/dev/null || echo "")
    copies=$(find "$path" -path "$path/.git" -prune -o -type f -name '* (conflict *)*' -print 2>/dev/null | wc -l)

    if (( conflicts > 0 )) || $rebasing; then state="conflict"
    elif (( v_ahead > 0 && v_behind > 0 )) || (( dirty > 0 && v_behind > 0 )); then state="diverged"
    elif (( v_behind > 0 )); then state="behind"
    elif (( dirty > 0 )); then state="modified"
    elif (( v_ahead > 0 )); then state="ahead"
    elif ! $upstream; then state="unpublished"
    else state="synced"
    fi
    # Conflict copies need a human; flag a vault that is otherwise clean.
    (( copies > 0 )) && [[ $state == synced || $state == unpublished ]] && state="copies"

    in_obsidian=false
    is_registered "$(realpath "$path")" && in_obsidian=true

    vaults_json=$(jq -c \
      --arg name "$name" --arg path "$path" --arg state "$state" \
      --argjson dirty "$dirty" --argjson ahead "$v_ahead" --argjson behind "$v_behind" \
      --argjson lastCommit "${last_commit:-0}" --argjson copies "$copies" \
      --argjson inObsidian "$in_obsidian" \
      '. + [{name: $name, path: $path, state: $state, dirty: $dirty, ahead: $ahead, behind: $behind, lastCommit: $lastCommit, conflictCopies: $copies, inObsidian: $inObsidian}]' \
      <<<"$vaults_json")
  done < <(find "$dir" -mindepth 1 -maxdepth 1 -type d ! -name '.*' -print0 | sort -z)

  # Read-only: Obsidian's vault list is changed only by `register` and `open`,
  # i.e. when the user asks.
  local obsidian_running=false
  [[ -n $(obsidian_pid) ]] && obsidian_running=true

  jq -cn \
    --arg dir "$dir" --arg branch "$branch" --arg remote "$remote_url" \
    --argjson obsidianRunning "$obsidian_running" \
    --argjson upstream "$upstream" --argjson ahead "${ahead:-0}" --argjson behind "${behind:-0}" \
    --argjson rebasing "$rebasing" --argjson lastFetch "$last_fetch" \
    --argjson vaults "$vaults_json" \
    '{ok: true, cloned: true, dir: $dir, remote: $remote, branch: $branch, upstream: $upstream,
      ahead: $ahead, behind: $behind, rebasing: $rebasing, lastFetch: $lastFetch,
      obsidianRunning: $obsidianRunning, vaults: $vaults}'
}

cmd_clone() {
  local url="${1:-}" dir out
  [[ -n $url ]] || fail "no repository URL configured"
  expand_dir "${2:-}"
  in_repo "$dir" && ok "Already cloned"
  if [[ -e $dir ]] && [[ -n $(ls -A "$dir" 2>/dev/null) ]]; then
    fail "$dir exists and is not empty"
  fi
  mkdir -p "$(dirname "$dir")" || fail "cannot create $(dirname "$dir")"
  out=$(git clone --quiet -- "$url" "$dir" 2>&1) || fail "clone failed: $(git_error "$out")"
  ok "Cloned into $dir"
}

do_fetch() {
  local dir="$1" out
  git -C "$dir" remote get-url origin >/dev/null 2>&1 || fail "repository has no 'origin' remote"
  out=$(git -C "$dir" fetch --quiet --prune origin 2>&1) || fail "fetch failed: $(git_error "$out")"
  ok "Fetched"
}

cmd_fetch() {
  local dir gitdir max_age=0
  expand_dir "${1:-}"
  [[ ${2:-} == --max-age ]] && max_age="${3:-0}"
  [[ $max_age =~ ^[0-9]+$ ]] || fail "--max-age must be a number of seconds"
  in_repo "$dir" || fail "not cloned yet"
  # Several bar instances (one per monitor) share one schedule; only the first
  # one in each window actually goes to the network.
  if (( max_age > 0 )); then
    gitdir=$(git -C "$dir" rev-parse --absolute-git-dir)
    if [[ -f $gitdir/FETCH_HEAD ]] && (( $(date +%s) - $(stat -c %Y "$gitdir/FETCH_HEAD") < max_age )); then
      ok "Fetched recently"
    fi
  fi
  with_lock "$dir" do_fetch "$dir"
}

# "notes/todo.md" -> "notes/todo (conflict <host> <stamp>).md"; if that name is
# taken, "... <stamp> 2).md", "... 3).md", and so on.
conflict_copy_name() {
  local dir="$1" path="$2" stamp="$3" dirpart base stem ext tag candidate n=1
  dirpart=$(dirname -- "$path")
  base=$(basename -- "$path")
  if [[ $base =~ ^[^.].*\.[^.]+$ ]]; then
    stem="${base%.*}"; ext=".${base##*.}"
  else
    stem="$base"; ext=""
  fi
  while :; do
    tag="conflict $stamp"; (( n > 1 )) && tag="$tag $n"
    candidate="$stem ($tag)$ext"
    [[ $dirpart != . ]] && candidate="$dirpart/$candidate"
    [[ -e $dir/$candidate || -L $dir/$candidate ]] || break
    n=$((n + 1))
  done
  printf '%s' "$candidate"
}

# True if "$dir/$rel" stays inside the repo through real directories only:
# no component (nor the file itself) is a symlink.
inside_repo_no_symlinks() {
  local dir="$1" rel="$2" part current="$1"
  [[ $rel != /* && $rel != *..* ]] || return 1
  IFS='/' read -r -a parts <<<"$rel"
  for part in "${parts[@]}"; do
    current="$current/$part"
    [[ -L $current ]] && return 1
  done
  return 0
}

# Resolve every unmerged path of the commit being replayed. During a rebase,
# stage 2 is the upstream version and stage 3 is the local one. The upstream
# version keeps the name and the local one is saved beside it; when one side
# deleted the file, the surviving edit is kept and no copy is made.
resolve_conflicts_with_copies() {
  local dir="$1" stamp="$2" path stages copy
  while IFS= read -r -d '' path; do
    stages=$(git -C "$dir" ls-files -u -z -- "$path" | tr '\0' '\n' | awk '{print $3}' | sort -u | tr -d '\n')
    case "$stages" in
      *2*3*)
        # One copy per note per sync: later local commits touching the same
        # note refresh it, so it ends up holding the latest local version.
        copy="${COPY_FOR[$path]:-}"
        [[ -n $copy ]] || copy=$(conflict_copy_name "$dir" "$path" "$stamp")
        inside_repo_no_symlinks "$dir" "$copy" || return 1
        mkdir -p "$dir/$(dirname -- "$copy")" || return 1
        git -C "$dir" cat-file -p ":3:$path" >"$dir/$copy" || return 1
        git -C "$dir" checkout --ours -- "$path" || return 1
        git -C "$dir" add -- "$path" "$copy" || return 1
        [[ -n ${COPY_FOR[$path]:-} ]] || CONFLICT_COPIES+=("$copy")
        COPY_FOR[$path]="$copy"
        ;;
      *3*) git -C "$dir" checkout --theirs -- "$path" && git -C "$dir" add -- "$path" || return 1 ;;
      *2*) git -C "$dir" checkout --ours -- "$path" && git -C "$dir" add -- "$path" || return 1 ;;
      *)   git -C "$dir" rm -q --cached -- "$path" >/dev/null 2>&1 ;;
    esac
  done < <(git -C "$dir" diff --name-only --diff-filter=U -z)
  [[ -z $(git -C "$dir" diff --name-only --diff-filter=U) ]]
}

# Rebase onto upstream, turning content conflicts into conflict copies.
# Anything unexpected aborts the rebase, so the repo is never left mid-rebase.
rebase_with_conflict_copies() {
  local dir="$1" gitdir stamp out tries=0
  gitdir=$(git -C "$dir" rev-parse --absolute-git-dir)
  stamp="$(hostname) $(date '+%Y-%m-%d %H%M')"
  CONFLICT_COPIES=()
  declare -gA COPY_FOR=()
  out=$(git -C "$dir" rebase --autostash '@{u}' 2>&1) && return 0
  while [[ -d $gitdir/rebase-merge || -d $gitdir/rebase-apply ]]; do
    tries=$((tries + 1))
    if (( tries > 200 )) || ! resolve_conflicts_with_copies "$dir" "$stamp"; then
      git -C "$dir" rebase --abort >/dev/null 2>&1
      return 1
    fi
    # A commit whose changes all lost to upstream has nothing left to apply.
    if git -C "$dir" diff --cached --quiet; then
      out=$(git -C "$dir" rebase --skip 2>&1) && break
    else
      out=$(GIT_EDITOR=true git -C "$dir" rebase --continue 2>&1) && break
    fi
    [[ -n $(git -C "$dir" diff --name-only --diff-filter=U) ]] && continue
    [[ -d $gitdir/rebase-merge || -d $gitdir/rebase-apply ]] || break
    git -C "$dir" rebase --abort >/dev/null 2>&1
    return 1
  done
  [[ ! -d $gitdir/rebase-merge && ! -d $gitdir/rebase-apply ]]
}

do_sync() {
  local dir="$1" vault="$2" scope="." label="all vaults" out gitdir
  gitdir=$(git -C "$dir" rev-parse --absolute-git-dir)
  if [[ -n $vault ]]; then
    valid_vault "$vault" && [[ -d $dir/$vault ]] || fail "unknown vault: $vault"
    scope="$vault"
    label="$vault"
  fi

  [[ -d $gitdir/rebase-merge || -d $gitdir/rebase-apply || -f $gitdir/MERGE_HEAD ]] \
    && fail "a rebase or merge is in progress in $dir; finish it manually first"
  git -C "$dir" symbolic-ref -q HEAD >/dev/null || fail "repository is on a detached HEAD"

  # 1. Commit local changes in scope.
  git -C "$dir" add -A -- "$scope" || fail "git add failed"
  if ! git -C "$dir" diff --cached --quiet -- "$scope"; then
    local msg
    msg="omaVaults: sync $label from $(hostname) at $(date '+%Y-%m-%d %H:%M')"
    out=$(git -C "$dir" commit --quiet -m "$msg" -- "$scope" 2>&1) || fail "commit failed: $(git_error "$out")"
  fi

  # 2. Integrate remote changes. Autostash covers dirty files in *other*
  #    vaults when syncing just one. Notes changed on both sides keep the
  #    remote version under their name and the local one as a conflict copy,
  #    so the working tree never holds conflict markers.
  CONFLICT_COPIES=()
  local stashes_before
  stashes_before=$(git -C "$dir" stash list | wc -l)
  out=$(git -C "$dir" fetch --quiet --prune origin 2>&1) || fail "fetch failed: $(git_error "$out")"
  if has_upstream "$dir" && [[ -n $(git -C "$dir" rev-list -1 'HEAD..@{u}') ]]; then
    rebase_with_conflict_copies "$dir" \
      || fail "local and remote edits could not be combined automatically; your changes are committed locally but not pushed. To finish by hand, pull with rebase in $dir and resolve the conflicting files."
  fi
  # A failed autostash re-apply leaves the stash in place rather than losing it.
  (( $(git -C "$dir" stash list | wc -l) > stashes_before )) \
    && fail "synced, but uncommitted changes in other vaults could not be re-applied; they are kept in the git stash of $dir."

  # 3. Publish.
  if has_upstream "$dir"; then
    if [[ -n $(git -C "$dir" rev-list -1 '@{u}..HEAD') ]]; then
      out=$(git -C "$dir" push --quiet 2>&1) || fail "push failed: $(git_error "$out")"
    fi
  elif git -C "$dir" rev-parse -q --verify HEAD >/dev/null; then
    out=$(git -C "$dir" push --quiet -u origin HEAD 2>&1) || fail "push failed: $(git_error "$out")"
  fi

  if (( ${#CONFLICT_COPIES[@]} )); then
    printf '%s\0' "${CONFLICT_COPIES[@]}" | jq -Rsc --arg label "$label" '
      split("\u0000") | map(select(. != "")) as $copies
      | {ok: true, conflicts: ($copies | length), conflictCopies: $copies,
         message: ("Synced " + $label + " · kept " + ($copies | length | tostring)
           + (if ($copies | length) == 1 then " conflict copy" else " conflict copies" end)
           + " to merge")}'
    exit 0
  fi
  ok "Synced $label"
}

# Per-device Obsidian state, kept out of git for every vault the plugin makes.
write_vault_gitignore() {
  cat >"$1/.gitignore" <<'IGNORE'
# Per-device Obsidian state
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.trash/
IGNORE
}

# Sets $name to the trimmed, validated vault name. Vault names become folder
# names at the top of the repo.
check_vault_name() {
  name="${1:-}"
  name="${name#"${name%%[![:space:]]*}"}"
  name="${name%"${name##*[![:space:]]}"}"
  valid_vault "$name" || fail "invalid vault name: names can't be empty, start with '.', or contain '/'"
  [[ $name =~ [[:cntrl:]] ]] && fail "invalid vault name: control characters aren't allowed"
  (( ${#name} <= 100 )) || fail "vault name is too long"
}

# Commit and push a freshly added vault. Runs the sync in a subshell so a
# failed push still reports the vault as added (it is committed locally).
publish_new_vault() {
  local dir="$1" name="$2" verb="$3" out
  if out=$(do_sync "$dir" "$name"); then
    ok "$verb $name"
  fi
  jq -cn --arg msg "$verb $name" --arg error "$(jq -r '.error // empty' <<<"$out" 2>/dev/null)" \
    '{ok: true, message: ($msg + " locally; not pushed yet" + (if $error != "" then " (" + $error + ")" else "" end))}'
  exit 0
}

# A new vault: minimal Obsidian config plus a .gitignore for the per-device
# workspace files, so opening the vault doesn't immediately mark it modified.
do_create() {
  local dir="$1" name="$2" path
  path="$dir/$name"
  [[ -e $path ]] && fail "a vault or file named \"$name\" already exists"

  mkdir -p "$path/.obsidian" || fail "cannot create $path"
  echo '{}' >"$path/.obsidian/app.json"
  write_vault_gitignore "$path"
  printf '# %s\n' "$name" >"$path/Welcome.md"
  publish_new_vault "$dir" "$name" "Created"
}

cmd_create() {
  local dir name
  expand_dir "${1:-}"
  in_repo "$dir" || fail "not cloned yet"
  check_vault_name "${2:-}"
  with_lock "$dir" do_create "$dir" "$name"
}

# GitHub rejects files of 100 MB or more; refuse before copying anything.
MAX_FILE_MB=95

do_import() {
  local dir="$1" src="$2" name="$3" path big
  path="$dir/$name"
  [[ -e $path ]] && fail "a vault or file named \"$name\" already exists"

  big=$(find "$src" -type f -size +"${MAX_FILE_MB}"M ! -path '*/.git/*' -printf '%P\n' -quit 2>/dev/null)
  [[ -z $big ]] || fail "\"$big\" is larger than ${MAX_FILE_MB} MB; git hosts reject files that big"

  # The source is only read. Skip git metadata and per-device Obsidian state.
  rsync -a --exclude='.git' --exclude='.obsidian/workspace*.json' \
    --exclude='.obsidian/cache' --exclude='.trash/' "$src/" "$path/" \
    || { rm -rf "$path"; fail "copy failed"; }
  [[ -d $path/.obsidian ]] || mkdir -p "$path/.obsidian"
  [[ -e $path/.gitignore ]] || write_vault_gitignore "$path"
  publish_new_vault "$dir" "$name" "Imported"
}

cmd_import() {
  local dir src name
  expand_dir "${1:-}"
  in_repo "$dir" || fail "not cloned yet"
  src="${2:-}"
  [[ $src == "~" || $src == "~/"* ]] && src="$HOME${src:1}"
  [[ -n $src ]] || fail "no folder to import"
  src=$(realpath -e -- "$src" 2>/dev/null) || fail "folder not found: ${2:-}"
  [[ -d $src ]] || fail "not a folder: $src"
  local repo_root
  repo_root=$(realpath -e -- "$dir")
  [[ $src == "$repo_root" || $src == "$repo_root"/* ]] && fail "that folder is already inside the vaults repo"
  [[ $repo_root == "$src"/* ]] && fail "that folder contains the vaults repo"
  [[ $src == "$HOME" || $src == / ]] && fail "refusing to import $src"
  check_vault_name "${3:-$(basename "$src")}"
  with_lock "$dir" do_import "$dir" "$src" "$name"
}

# "host/owner/repo" for comparing remotes across ssh/https spellings.
remote_slug() {
  printf '%s' "$1" | sed -E 's#^[a-z+]+://##; s#^[^@/]+@##; s#:#/#; s#\.git/?$##; s#/+$##' | tr '[:upper:]' '[:lower:]'
}

# Vaults Obsidian knows about that live outside the repo: import candidates.
# A folder inside another clone of this same repo is flagged as a duplicate.
cmd_candidates() {
  local dir repo_root slug list="[]" path name top other files kb
  expand_dir "${1:-}"
  in_repo "$dir" || fail "not cloned yet"
  repo_root=$(realpath -e -- "$dir")
  slug=$(remote_slug "$(git -C "$dir" remote get-url origin 2>/dev/null)")
  [[ -s $OBSIDIAN_CONFIG ]] || { jq -cn '{ok: true, candidates: []}'; return; }

  while IFS= read -r path; do
    [[ -d $path ]] || continue
    path=$(realpath -e -- "$path") || continue
    [[ $path == "$repo_root" || $path == "$repo_root"/* ]] && continue
    name=$(basename "$path")
    other=""
    if top=$(git -C "$path" rev-parse --show-toplevel 2>/dev/null); then
      [[ -n $slug && $(remote_slug "$(git -C "$top" remote get-url origin 2>/dev/null)") == "$slug" ]] && other="$top"
    fi
    files=$(find "$path" -type f ! -path '*/.git/*' 2>/dev/null | wc -l)
    kb=$(du -sk --exclude=.git "$path" 2>/dev/null | cut -f1)
    list=$(jq -c --arg path "$path" --arg name "$name" --arg dup "$other" \
      --argjson files "$files" --argjson kb "${kb:-0}" \
      '. + [{path: $path, name: $name, files: $files, sizeKB: $kb, duplicateOf: (if $dup == "" then null else $dup end)}]' <<<"$list")
  done < <(jq -r '(.vaults // {})[] | .path' "$OBSIDIAN_CONFIG" 2>/dev/null)

  jq -cn --argjson c "$list" '{ok: true, candidates: $c}'
}

# Folder chooser through the XDG desktop portal (the desktop's own dialog, no
# extra packages), falling back to zenity or kdialog when the portal can't be
# reached from Python.
pick_folder_portal() {
  python3 - "$1" <<'PY'
import sys, json
try:
    import gi
    gi.require_version("Gio", "2.0")
    from gi.repository import Gio, GLib
except Exception:
    sys.exit(2)

start = sys.argv[1] if len(sys.argv) > 1 else ""
try:
    bus = Gio.bus_get_sync(Gio.BusType.SESSION)
except Exception:
    sys.exit(2)

token = "omavaults%d" % GLib.random_int()
sender = bus.get_unique_name()[1:].replace(".", "_")
handle = "/org/freedesktop/portal/desktop/request/%s/%s" % (sender, token)
loop = GLib.MainLoop()
result = {"code": 2, "uris": []}

def on_response(_conn, _sender, _path, _iface, _signal, params):
    code, results = params.unpack()
    result["code"] = code
    result["uris"] = results.get("uris", [])
    loop.quit()

# Subscribe before calling, so a fast response can't be missed.
bus.signal_subscribe("org.freedesktop.portal.Desktop", "org.freedesktop.portal.Request",
                     "Response", handle, None, Gio.DBusSignalFlags.NO_MATCH_RULE, on_response)
options = {
    "handle_token": GLib.Variant("s", token),
    "directory": GLib.Variant("b", True),
    "modal": GLib.Variant("b", True),
}
if start:
    options["current_folder"] = GLib.Variant("ay", list(start.encode()) + [0])
try:
    bus.call_sync("org.freedesktop.portal.Desktop", "/org/freedesktop/portal/desktop",
                  "org.freedesktop.portal.FileChooser", "OpenFile",
                  GLib.Variant("(ssa{sv})", ("", "Choose a vault folder to import", options)),
                  None, Gio.DBusCallFlags.NONE, -1, None)
except Exception:
    sys.exit(2)
loop.run()
if result["code"] == 0 and result["uris"]:
    print(Gio.File.new_for_uri(result["uris"][0]).get_path() or "")
    sys.exit(0)
sys.exit(1)  # cancelled
PY
}

cmd_pick_folder() {
  local start="${1:-$HOME}" path rc
  [[ $start == "~" || $start == "~/"* ]] && start="$HOME${start:1}"
  [[ -d $start ]] || start="$HOME"
  path=$(pick_folder_portal "$start")
  rc=$?
  if (( rc == 2 )); then
    if command -v zenity >/dev/null; then
      path=$(zenity --file-selection --directory --filename="$start/" 2>/dev/null); rc=$?
    elif command -v kdialog >/dev/null; then
      path=$(kdialog --getexistingdirectory "$start" 2>/dev/null); rc=$?
    else
      fail "no folder chooser available (needs the XDG desktop portal with python-gobject, zenity, or kdialog); type the path instead"
    fi
  fi
  if (( rc != 0 )) || [[ -z $path ]]; then
    jq -cn '{ok: false, cancelled: true, error: "No folder chosen"}'
    exit 1
  fi
  jq -cn --arg path "$path" '{ok: true, path: $path}'
}

# Updates the plugin's own settings file, keeping keys it isn't told about.
#   config-save <url> <dir> [interval]   repository settings
#   config-save --ack-public <url>       "this public repo is meant to be public"
#   config-save --dismiss-register <url> <names-json>
#                                        "don't offer to add these vaults to Obsidian"
cmd_config_save() {
  local filter tmp current='{}'
  [[ -s $OMAVAULTS_CONFIG ]] && current=$(jq -c 'if type == "object" then . else {} end' "$OMAVAULTS_CONFIG" 2>/dev/null || echo '{}')
  if [[ ${1:-} == --ack-public ]]; then
    [[ -n ${2:-} ]] || fail "no repository URL given"
    filter=$(jq -cn --arg url "$2" '{publicAcknowledged: $url}')
  elif [[ ${1:-} == --dismiss-register ]]; then
    [[ -n ${2:-} ]] || fail "no repository URL given"
    jq -e 'type == "array" and all(.[]; type == "string")' <<<"${3:-}" >/dev/null 2>&1 \
      || fail "vault names must be a JSON array of strings"
    filter=$(jq -cn --argjson cur "$current" --arg url "$2" --argjson names "$3" \
      '{registerDismissed: (($cur.registerDismissed // {}) + {($url): $names})}')
  else
    local url="${1:-}" path="${2:-}" interval="${3:-300}"
    [[ -n $url ]] || fail "no repository URL given"
    [[ -n $path ]] || fail "no local path given"
    [[ $interval =~ ^[0-9]+$ ]] || fail "interval must be a number of seconds"
    filter=$(jq -cn --arg url "$url" --arg path "$path" --argjson interval "$interval" \
      '{repoUrl: $url, localPath: $path, refreshIntervalSec: $interval}')
  fi
  mkdir -p -m 700 "$(dirname "$OMAVAULTS_CONFIG")" || fail "cannot create $(dirname "$OMAVAULTS_CONFIG")"
  tmp=$(mktemp "$OMAVAULTS_CONFIG.XXXXXX") || fail "cannot write $OMAVAULTS_CONFIG"
  if jq -n --argjson cur "$current" --argjson set "$filter" '$cur + $set' >"$tmp"; then
    mv "$tmp" "$OMAVAULTS_CONFIG"
  else
    rm -f "$tmp"
    fail "cannot write $OMAVAULTS_CONFIG"
  fi
  ok "Saved"
}

# Is the repository readable by anyone? One anonymous request to the host's
# API (no credentials, no redirects, only the status code is read), cached for
# an hour so per-monitor widget instances don't repeat it.
VISIBILITY_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/omavaults/visibility.json"

cmd_visibility() {
  local url="${1:-}" slug host repo api code visibility="unknown" now cache='{}' cached
  [[ -n $url ]] || fail "no repository URL given"
  slug=$(remote_slug "$url")
  host="${slug%%/*}"; repo="${slug#*/}"
  now=$(date +%s)
  [[ -s $VISIBILITY_CACHE ]] && cache=$(jq -c 'if type == "object" then . else {} end' "$VISIBILITY_CACHE" 2>/dev/null || echo '{}')
  cached=$(jq -c --arg s "$slug" --argjson now "$now" '.[$s] | select(. != null and ($now - .at) < 3600)' <<<"$cache")
  if [[ -n $cached ]]; then
    jq -cn --argjson c "$cached" --arg host "$host" '{ok: true, visibility: $c.visibility, host: $host, cached: true}'
    return
  fi

  # Only "owner/repo" shaped paths on hosts with a public API are checked.
  if [[ $repo =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]]; then
    case "$host" in
      github.com) api="https://api.github.com/repos/$repo" ;;
      gitlab.com) api="https://gitlab.com/api/v4/projects/$(jq -rn --arg r "$repo" '$r | @uri')" ;;
      codeberg.org) api="https://codeberg.org/api/v1/repos/$repo" ;;
    esac
  fi
  if [[ -n ${api:-} ]] && command -v curl >/dev/null; then
    code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 8 --max-redirs 0 \
      -H 'User-Agent: omaVaults' -H 'Accept: application/json' "$api" 2>/dev/null)
    case "$code" in
      200) visibility="public" ;;
      404|401|403) visibility="private" ;;   # private, or not visible anonymously
    esac
  fi

  # Cache definite answers only, so a network blip is retried next time.
  if [[ $visibility != unknown ]]; then
    mkdir -p -m 700 "$(dirname "$VISIBILITY_CACHE")"
    local tmp
    tmp=$(mktemp "$VISIBILITY_CACHE.XXXXXX") && \
      jq -n --argjson cur "$cache" --arg s "$slug" --arg v "$visibility" --argjson now "$now" \
        '$cur + {($s): {visibility: $v, at: $now}}' >"$tmp" && mv "$tmp" "$VISIBILITY_CACHE" || rm -f "$tmp"
  fi
  jq -cn --arg v "$visibility" --arg host "$host" '{ok: true, visibility: $v, host: $host}'
}

cmd_sync() {
  local dir
  expand_dir "${1:-}"
  in_repo "$dir" || fail "not cloned yet"
  with_lock "$dir" do_sync "$dir" "${2:-}"
}

# Obsidian only opens vaults listed in obsidian.json, and only reads that file
# at startup: a running instance answers an unknown path with "Vault not
# found", and rewrites the file from memory (dropping anything added behind its
# back). So the file is only ever written while Obsidian is not running.

obsidian_pid() {
  # The Electron main process: started as an `obsidian` binary (packaged,
  # AppImage, Flatpak) or as electron running obsidian's app.asar. Renderers
  # carry --type=. Never match this script or its parent.
  local pid argv0 args
  for pid in $(pgrep -f -i -- 'obsidian' 2>/dev/null); do
    [[ $pid == "$$" || $pid == "$PPID" ]] && continue
    [[ -r /proc/$pid/cmdline ]] || continue
    args=$(tr '\0' '\n' <"/proc/$pid/cmdline" 2>/dev/null)
    grep -qx -- '--type=.*' <<<"$args" && continue
    argv0=$(head -n 1 <<<"$args")
    if [[ $(basename -- "$argv0") =~ ^[Oo]bsidian$ ]] \
      || grep -qE '/obsidian/(app|obsidian)\.asar$' <<<"$args"; then
      echo "$pid"
      return
    fi
  done
}

is_registered() {
  [[ -s $OBSIDIAN_CONFIG ]] &&
    jq -e --arg p "$1" '(.vaults // {}) | any(.[]; .path == $p)' "$OBSIDIAN_CONFIG" >/dev/null 2>&1
}

# Adds every given path that is not registered yet. Caller ensures Obsidian is
# not running.
register_vaults() {
  local missing=() path tmp
  for path in "$@"; do is_registered "$path" || missing+=("$path"); done
  (( ${#missing[@]} )) || return 0

  mkdir -p "$(dirname "$OBSIDIAN_CONFIG")"
  [[ -s $OBSIDIAN_CONFIG ]] || echo '{"vaults":{}}' >"$OBSIDIAN_CONFIG"
  jq -e . "$OBSIDIAN_CONFIG" >/dev/null 2>&1 || fail "cannot parse $OBSIDIAN_CONFIG"

  local additions="{}" ts
  ts=$(date +%s%3N)
  for path in "${missing[@]}"; do
    additions=$(jq -c --arg id "$(od -An -N8 -tx1 /dev/urandom | tr -d ' \n')" --arg p "$path" --argjson ts "$ts" \
      '. + {($id): {path: $p, ts: $ts}}' <<<"$additions")
  done

  tmp=$(mktemp "$OBSIDIAN_CONFIG.XXXXXX") || fail "cannot write $OBSIDIAN_CONFIG"
  if jq --argjson add "$additions" '.vaults = ((.vaults // {}) + $add)' "$OBSIDIAN_CONFIG" >"$tmp"; then
    mv "$tmp" "$OBSIDIAN_CONFIG"
  else
    rm -f "$tmp"
    fail "cannot update $OBSIDIAN_CONFIG"
  fi
}

# Add every repo vault missing from Obsidian's list — only when the user asks
# (the panel's "Add to Obsidian"). With --restart, a running Obsidian is quit
# cleanly first and started again afterwards.
cmd_register() {
  local dir restart=false paths=() path running=false name
  if [[ ${1:-} == --restart ]]; then restart=true; shift; fi
  expand_dir "${1:-}"
  shift
  in_repo "$dir" || fail "not cloned yet"
  if (( $# )); then
    for name in "$@"; do
      valid_vault "$name" || fail "invalid vault name: $name"
      path=$(realpath -e "$dir/$name" 2>/dev/null) || fail "vault not found: $name"
      is_registered "$path" || paths+=("$path")
    done
  else
    while IFS= read -r -d '' path; do
      path=$(realpath "$path")
      is_registered "$path" || paths+=("$path")
    done < <(find "$dir" -mindepth 1 -maxdepth 1 -type d ! -name '.*' -print0 | sort -z)
  fi
  (( ${#paths[@]} )) || ok "All vaults are already in Obsidian"

  if [[ -n $(obsidian_pid) ]]; then
    $restart || {
      jq -cn --argjson n "${#paths[@]}" \
        '{ok: false, needsRestart: true, error: "Obsidian must restart to add the vaults"}'
      exit 3
    }
    stop_obsidian
    running=true
  fi
  register_vaults "${paths[@]}"
  if $running; then
    setsid -f xdg-open "obsidian://open" >/dev/null 2>&1 </dev/null
  fi
  jq -cn --argjson n "${#paths[@]}" \
    '{ok: true, registered: $n, message: ("Added " + ($n | tostring) + (if $n == 1 then " vault" else " vaults" end) + " to Obsidian")}'
}

stop_obsidian() {
  local pid
  pid=$(obsidian_pid)
  [[ -n $pid ]] || return 0
  kill -TERM "$pid" 2>/dev/null
  for _ in $(seq 50); do
    kill -0 "$pid" 2>/dev/null || return 0
    sleep 0.2
  done
  fail "Obsidian did not quit; close it and try again"
}

cmd_open() {
  local dir vault path uri restart=false
  if [[ ${1:-} == --restart ]]; then restart=true; shift; fi
  expand_dir "${1:-}"
  vault="${2:-}"
  valid_vault "$vault" || fail "invalid vault name: $vault"
  path=$(realpath -e "$dir/$vault" 2>/dev/null) || fail "vault not found: $vault"
  [[ -d $path/.obsidian ]] || mkdir -p "$path/.obsidian"

  if ! is_registered "$path"; then
    if [[ -n $(obsidian_pid) ]]; then
      $restart || {
        jq -cn --arg vault "$vault" \
          '{ok: false, needsRestart: true, vault: $vault, error: ("Obsidian must restart once to add \"" + $vault + "\"")}'
        exit 3
      }
      stop_obsidian
    fi
    register_vaults "$path"
  fi

  uri="obsidian://open?path=$(jq -rn --arg p "$path" '$p | @uri')"
  setsid -f xdg-open "$uri" >/dev/null 2>&1 </dev/null || fail "could not launch Obsidian"
  ok "Opening $vault"
}

command -v git >/dev/null || fail "git is not installed"
command -v jq >/dev/null || { echo '{"ok":false,"error":"jq is not installed"}'; exit 1; }

case "${1:-}" in
  status) shift; cmd_status "$@" ;;
  clone) shift; cmd_clone "$@" ;;
  fetch) shift; cmd_fetch "$@" ;;
  sync) shift; cmd_sync "$@" ;;
  create) shift; cmd_create "$@" ;;
  import) shift; cmd_import "$@" ;;
  candidates) shift; cmd_candidates "$@" ;;
  pick-folder) shift; cmd_pick_folder "$@" ;;
  config-save) shift; cmd_config_save "$@" ;;
  visibility) shift; cmd_visibility "$@" ;;
  open) shift; cmd_open "$@" ;;
  register) shift; cmd_register "$@" ;;
  *) fail "usage: omavaults {status|clone|fetch|sync|create|import|candidates|pick-folder|register|open|config-save|visibility} ..." ;;
esac
